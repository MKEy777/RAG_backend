# ====================================================
# PyRAG 环境变量配置示例
# 复制为 .env 后修改真实值
# 所有变量前缀为 PYRAG_
# ====================================================

# --- LLM: Chat / VLM / Rerank (opencode.ai) ---
PYRAG_LLM_API_KEY=sk-your-opencode-key
# PYRAG_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# PYRAG_LLM_CHAT_MODEL=deepseek-v4-flash
# PYRAG_LLM_VLM_MODEL=mimo-v2.5
# PYRAG_LLM_RERANK_MODEL=deepseek-v4-flash
# PYRAG_LLM_RERANK_BASE_URL=https://opencode.ai/zen/go/v1

# --- LLM: Embedding (SiliconFlow) ---
PYRAG_LLM_EMBED_API_KEY=sk-your-siliconflow-key
# PYRAG_LLM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# PYRAG_LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# PYRAG_EMBEDDING_DIMS=1024

# --- Database ---
# PYRAG_DATABASE_URL=sqlite:///./pyrag.db

# --- Redis / Celery ---
# PYRAG_REDIS_URL=redis://localhost:6379/0
# PYRAG_CELERY_BROKER_URL=redis://localhost:6379/1
# PYRAG_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ---
# PYRAG_STORAGE_PROFILE=lite
# PYRAG_OBJECT_STORAGE_ROOT=./data/objects

# --- Embedding ---
# PYRAG_BATCH_EMBED_SIZE=5
# PYRAG_EMBED_MAX_CHARS=20000
# PYRAG_EMBED_RETRY_COUNT=5
# PYRAG_EMBED_RETRY_BASE_MS=200

# --- Chunking ---
# PYRAG_CHUNK_SIZE=512
# PYRAG_CHUNK_OVERLAP=80
# PYRAG_PARENT_CHUNK_SIZE=4096
# PYRAG_CHILD_CHUNK_SIZE=384
# PYRAG_PROTECT_BLOCK_LIMIT=7500

# --- Retrieval ---
# PYRAG_RRF_K=60
# PYRAG_RRF_VECTOR_WEIGHT=0.7
# PYRAG_RRF_KEYWORD_WEIGHT=0.3
# PYRAG_EMBEDDING_TOP_K=50
# PYRAG_VECTOR_THRESHOLD=0.15
# PYRAG_KEYWORD_THRESHOLD=0.3
# PYRAG_RERANK_TOP_K=10
# PYRAG_RERANK_THRESHOLD=0.2
# PYRAG_WIKI_BOOST=1.3

# --- Wiki ---
# PYRAG_WIKI_DEBOUNCE_INGEST_S=30
# PYRAG_WIKI_DEBOUNCE_FOLLOWUP_S=5
# PYRAG_WIKI_DEBOUNCE_FINALIZE_S=20
# PYRAG_WIKI_BATCH_MAX_DOCS=5
# PYRAG_WIKI_MAP_CONCURRENCY=10
# PYRAG_WIKI_REDUCE_CONCURRENCY=10
# PYRAG_WIKI_MAX_INFLIGHT=4
# PYRAG_WIKI_CITATION_BATCH_CHARS=12000
# PYRAG_WIKI_CITATION_CONCURRENCY=4
# PYRAG_WIKI_DEAD_LETTER_THRESHOLD=5
# PYRAG_WIKI_LLM_RETRY_COUNT=3
# PYRAG_WIKI_LLM_RETRY_BASE_S=2.0
# PYRAG_WIKI_MAX_SOURCE_CHARS=32768
# PYRAG_WIKI_DEDUP_JACCARD=0.08
# PYRAG_WIKI_DEDUP_TOP_K=5
# PYRAG_WIKI_DEDUP_BYPASS=25

# --- Graph ---
# PYRAG_GRAPH_ENTITY_CONCURRENCY=4
# PYRAG_GRAPH_RELATION_CONCURRENCY=4
# PYRAG_GRAPH_RELATION_BATCH_SIZE=5
# PYRAG_GRAPH_PMI_WEIGHT=0.6
# PYRAG_GRAPH_STRENGTH_WEIGHT=0.4
# PYRAG_GRAPH_TWO_HOP_DECAY=0.5
# PYRAG_GRAPH_PROFILE=lite

# --- FAQ ---
# PYRAG_FAQ_MAX_ITERATIONS=5
# PYRAG_FAQ_INITIAL_TOP_K_MULTIPLIER=3

# --- Indexing ---
# PYRAG_INDEX_BATCH_SIZE=40
# PYRAG_INDEX_CONCURRENCY=5

# --- Security ---
# PYRAG_MAX_UPLOAD_SIZE_MB=100
# PYRAG_RATE_LIMIT_PER_MINUTE=60
# PYRAG_MAX_KB_IDS_PER_QUERY=20
