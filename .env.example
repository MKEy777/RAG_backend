# ====================================================
# KnowLink 环境变量配置示例
# 复制为 .env 后取消注释并修改真实值
# 所有变量前缀为 KNOWLINK_
# ====================================================

# --- LLM: Chat / VLM / Rerank (opencode.ai) ---
# KNOWLINK_LLM_API_KEY=sk-xxx
# KNOWLINK_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# KNOWLINK_LLM_CHAT_MODEL=deepseek-v4-flash
# KNOWLINK_LLM_VLM_MODEL=mimo-v2.5
# KNOWLINK_LLM_RERANK_MODEL=deepseek-v4-flash
# KNOWLINK_LLM_RERANK_BASE_URL=https://opencode.ai/zen/go/v1

# --- LLM: Embedding (SiliconFlow) ---
# KNOWLINK_LLM_EMBED_API_KEY=sk-xxx
# KNOWLINK_LLM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# KNOWLINK_LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# KNOWLINK_EMBEDDING_DIMS=1024

# --- Database ---
# KNOWLINK_DATABASE_URL=sqlite:///./knowlink.db

# --- Redis / Celery ---
# KNOWLINK_REDIS_URL=redis://localhost:6379/0
# KNOWLINK_CELERY_BROKER_URL=redis://localhost:6379/1
# KNOWLINK_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ---
# KNOWLINK_STORAGE_PROFILE=lite
# KNOWLINK_OBJECT_STORAGE_ROOT=./data/objects

# --- Embedding ---
# KNOWLINK_BATCH_EMBED_SIZE=5
# KNOWLINK_EMBED_MAX_CHARS=20000
# KNOWLINK_EMBED_RETRY_COUNT=5
# KNOWLINK_EMBED_RETRY_BASE_MS=200

# --- Chunking ---
# KNOWLINK_CHUNK_SIZE=512
# KNOWLINK_CHUNK_OVERLAP=80
# KNOWLINK_PARENT_CHUNK_SIZE=4096
# KNOWLINK_CHILD_CHUNK_SIZE=384
# KNOWLINK_PROTECT_BLOCK_LIMIT=7500

# --- Retrieval ---
# KNOWLINK_RRF_K=60
# KNOWLINK_RRF_VECTOR_WEIGHT=0.7
# KNOWLINK_RRF_KEYWORD_WEIGHT=0.3
# KNOWLINK_EMBEDDING_TOP_K=50
# KNOWLINK_VECTOR_THRESHOLD=0.15
# KNOWLINK_KEYWORD_THRESHOLD=0.3
# KNOWLINK_RERANK_TOP_K=10
# KNOWLINK_RERANK_THRESHOLD=0.2
# KNOWLINK_WIKI_BOOST=1.3

# --- Wiki ---
# KNOWLINK_WIKI_DEBOUNCE_INGEST_S=30
# KNOWLINK_WIKI_DEBOUNCE_FOLLOWUP_S=5
# KNOWLINK_WIKI_DEBOUNCE_FINALIZE_S=20
# KNOWLINK_WIKI_BATCH_MAX_DOCS=5
# KNOWLINK_WIKI_MAP_CONCURRENCY=10
# KNOWLINK_WIKI_REDUCE_CONCURRENCY=10
# KNOWLINK_WIKI_MAX_INFLIGHT=4
# KNOWLINK_WIKI_CITATION_BATCH_CHARS=12000
# KNOWLINK_WIKI_CITATION_CONCURRENCY=4
# KNOWLINK_WIKI_DEAD_LETTER_THRESHOLD=5
# KNOWLINK_WIKI_LLM_RETRY_COUNT=3
# KNOWLINK_WIKI_LLM_RETRY_BASE_S=2.0
# KNOWLINK_WIKI_MAX_SOURCE_CHARS=32768
# KNOWLINK_WIKI_DEDUP_JACCARD=0.08
# KNOWLINK_WIKI_DEDUP_TOP_K=5
# KNOWLINK_WIKI_DEDUP_BYPASS=25

# --- Graph ---
# KNOWLINK_GRAPH_ENTITY_CONCURRENCY=4
# KNOWLINK_GRAPH_RELATION_CONCURRENCY=4
# KNOWLINK_GRAPH_RELATION_BATCH_SIZE=5
# KNOWLINK_GRAPH_PMI_WEIGHT=0.6
# KNOWLINK_GRAPH_STRENGTH_WEIGHT=0.4
# KNOWLINK_GRAPH_TWO_HOP_DECAY=0.5
# KNOWLINK_GRAPH_PROFILE=lite

# --- FAQ ---
# KNOWLINK_FAQ_MAX_ITERATIONS=5
# KNOWLINK_FAQ_INITIAL_TOP_K_MULTIPLIER=3

# --- Indexing ---
# KNOWLINK_INDEX_BATCH_SIZE=40
# KNOWLINK_INDEX_CONCURRENCY=5

# --- Security ---
# KNOWLINK_MAX_UPLOAD_SIZE_MB=100
# KNOWLINK_RATE_LIMIT_PER_MINUTE=60
# KNOWLINK_MAX_KB_IDS_PER_QUERY=20
